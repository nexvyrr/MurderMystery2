local AIM_LEAD = 0.16
local velTrack = {}

RunService.Heartbeat:Connect(function()
    local now = os.clock()
    for _, p in ipairs(Players:GetPlayers()) do
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            velTrack[p] = nil
        else
            local v = velTrack[p]
            if not v then
                velTrack[p] = { p = hrp.Position, t = now, v = Vector3.zero }
            elseif now - v.t >= 0.03 then
                v.v = (hrp.Position - v.p) / (now - v.t)
                v.p = hrp.Position
                v.t = now
            end
        end
    end
end)

local function leadTime()
    local ping = 0.04
    local okPing, res = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
    if okPing and type(res) == "number" and res > 0 and res < 1 then ping = res end
    return math.clamp(ping + AIM_LEAD, 0, 0.3)
end

local function aimAt(targetPlayer, targetHrp)
    local hum = targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    local vel
    if hum and hum.MoveDirection.Magnitude > 0.1 then
        vel = hum.MoveDirection.Unit * hum.WalkSpeed
    else
        vel = targetHrp.AssemblyLinearVelocity or Vector3.zero
        if vel.Magnitude < 0.5 then
            local tr = velTrack[targetPlayer]
            if tr and tr.v.Magnitude >= 0.5 then vel = tr.v end
        end
    end
    if vel.Magnitude < 0.5 then return targetHrp.Position end
    local predicted = targetHrp.Position + Vector3.new(vel.X, 0, vel.Z) * leadTime()
    local offset = predicted - targetHrp.Position
    if offset.Magnitude > 8 then predicted = targetHrp.Position + offset.Unit * 8 end
    return predicted
end

local function hasLineOfSight(targetChar, originPart)
    if not targetChar or not originPart then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character }
    params.RespectCanCollide = true
    local points = {}
    for _, n in ipairs({ "HumanoidRootPart", "Head", "UpperTorso", "Torso", "LeftFoot", "RightFoot" }) do
        local part = targetChar:FindFirstChild(n)
        if part then table.insert(points, part.Position) end
    end
    if #points == 0 and targetChar.PrimaryPart then table.insert(points, targetChar.PrimaryPart.Position) end
    for _, pos in ipairs(points) do
        local hit = workspace:Raycast(originPart.Position, pos - originPart.Position, params)
        if not hit then return true end
        if hit.Instance:IsDescendantOf(targetChar) then return true end
        if hit.Instance.Transparency > 0.5 then return true end
        if hit.Instance.CanCollide == false then return true end
    end
    return false
end

local function shootMurderer()
    if shootBusy then return false end
    shootBusy = true
    local function release(t) task.delay(t, function() shootBusy = false end) end

    local char = player.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not myHrp or not hum or hum.Health <= 0 then release(0.35); return false end

    local gun = char:FindFirstChild("Gun")
    if not gun then
        local bpGun = player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Gun")
        if not bpGun then release(0.5); return false end
        hum:EquipTool(bpGun)
        task.wait(0.1)
        gun = char:FindFirstChild("Gun")
        if not gun then release(0.5); return false end
    end

    local murderer = findMurderer()
    if not murderer or murderer == player or not murderer.Character then release(0.5); return false end
    local tHrp = murderer.Character:FindFirstChild("HumanoidRootPart")
    local tHum = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not tHrp or not tHum or tHum.Health <= 0 then release(0.5); return false end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote or not shootRemote:IsA("RemoteEvent") then release(0.5); return false end

    if (myHrp.Position - tHrp.Position).Magnitude > MAX_SHOOT_DISTANCE then release(0.5); return false end

    if wallCheckEnabled then
        local origin = char:FindFirstChild("RightHand") or myHrp
        if not hasLineOfSight(murderer.Character, origin) then release(0.5); return false end
    end

    local attachment = myHrp:FindFirstChild("GunRaycastAttachment")
    local originCF = attachment and attachment.WorldCFrame or CFrame.new(myHrp.Position)
    local okFire = pcall(function()
        shootRemote:FireServer(originCF, CFrame.new(aimAt(murderer, tHrp)))
    end)
    release(okFire and SHOOT_COOLDOWN or 0.5)
    return okFire
end

