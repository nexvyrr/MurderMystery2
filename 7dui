        else for i = 1, #listaJugadores do cleanESP(listaJugadores[i]) end end

        local gunDrop = currentMap and ffc(currentMap, "GunDrop")
        if gunDropESP and gunDrop and (myHrp.Position - gunDrop.Position).Magnitude <= MAX_ESP_DISTANCE then
